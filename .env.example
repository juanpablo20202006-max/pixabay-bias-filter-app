# Pixabay API Configuration (Backend Only)
PIXABAY_API_KEY=your_pixabay_api_key_here

# MongoDB Connection String (Local Docker instance or MongoDB Atlas)
# Local: mongodb://localhost:27017/pixabay_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pixabay_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pixabay_db
MONGODB_DB=pixabay_db

# Next.js Port
PORT=3001
